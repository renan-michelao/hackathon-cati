# Copie para .env e ajuste. Usado pelo docker compose (api e worker).

# Banco (no compose o host é "db")
POSTGRES_USER=leilao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=leilao
DATABASE_URL=postgres://leilao:troque-esta-senha@db:5432/leilao

# Sessão (RF02)
SESSION_TTL_MIN=120
COOKIE_SECURE=false

# Armazenamento de fotos compatível com S3 (RF07) — credenciais fornecidas pela organização
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=leilao-fotos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Limites (RF05/RF06) — valores curtos facilitam a demo
LIMIT_LEAD_MIN_SEC=30
LIMIT_DURATION_MIN_SEC=60
LIMIT_PHOTOS_MIN=3
LIMIT_PHOTOS_MAX=8
LIMIT_PHOTO_MAX_MB=5

# Prorrogação (RF15) e limite de frequência (RF13)
EXTENSION_WINDOW_SEC=120
EXTENSION_MAX_TOTAL_SEC=1800
BID_MIN_INTERVAL_MS=500
