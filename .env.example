# Copie para .env e ajuste. Usado pelo docker compose (api e worker).
# Na VM, troque a senha por uma aleatória: openssl rand -hex 16

# Banco (no compose o host é "db")
POSTGRES_USER=leilao
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=leilao
DATABASE_URL=postgres://leilao:troque-esta-senha@db:5432/leilao

# Sessão (RF02)
SESSION_TTL_MIN=120

# Esqueci minha senha: endereço do site usado no link do e-mail (na VM: http://200.18.99.113:8083)
APP_URL=http://localhost:8080
PASSWORD_RESET_TTL_MIN=30
COOKIE_SECURE=false

# Fotos (RF07/D29/D45): PADRÃO OFICIAL = disco da VM, no volume "fotos" do compose.
# Não é preciso configurar mais nada. (O código ainda aceita STORAGE_DRIVER=s3 como plano B,
# com S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY e S3_SECRET_KEY, mas isso fica desligado.)
STORAGE_DRIVER=local

# Limites (RF05/RF06) — valores curtos facilitam a demo
LIMIT_LEAD_MIN_SEC=30
LIMIT_DURATION_MIN_SEC=60
LIMIT_PHOTOS_MIN=3
LIMIT_PHOTOS_MAX=8
LIMIT_PHOTO_MAX_MB=5

# Prorrogação (RF15) e limite de frequência (RF13)
EXTENSION_WINDOW_SEC=120
EXTENSION_MAX_TOTAL_SEC=1800
BID_MIN_INTERVAL_MS=500
