# .env para rodar com Docker na máquina de desenvolvimento (perfil "local").
# Uso: cp .env.local.example .env && docker compose --profile local up -d --build
POSTGRES_USER=leilao
POSTGRES_PASSWORD=leilao-local
POSTGRES_DB=leilao
DATABASE_URL=postgres://leilao:leilao-local@db:5432/leilao

SESSION_TTL_MIN=120
COOKIE_SECURE=false

# Armazenamento S3 local (serviço s3-local do compose)
S3_ENDPOINT=http://s3-local:8333
S3_REGION=us-east-1
S3_BUCKET=leilao-fotos
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_FORCE_PATH_STYLE=true

LIMIT_LEAD_MIN_SEC=30
LIMIT_DURATION_MIN_SEC=60
EXTENSION_WINDOW_SEC=120
EXTENSION_MAX_TOTAL_SEC=1800
BID_MIN_INTERVAL_MS=500
